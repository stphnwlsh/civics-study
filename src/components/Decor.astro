---
/*
  Campaign-season decorations: yard signs, "I Voted" stickers, buttons and bunting.

  On wide screens they sit in the empty margins on either side of the reading column. On
  narrower screens they move into a strip above the footer, so they never cover anything she
  is reading. Click a sticker for a little surprise.

  Her name comes from the STUDENT_NAME repository secret at build time. It only ends up inside
  the password-protected pages, never in this public source.
*/
interface Props {
  page: 'home' | 'question' | 'quiz' | 'glossary' | 'settings';
}
const { page } = Astro.props;

// read at build time on the build machine (Node), never in the browser
const env = (globalThis as { process?: { env: Record<string, string | undefined> } }).process?.env ?? {};
const name = (env.STUDENT_NAME ?? '').trim() || 'You';
const NAME = name.toUpperCase();
// shrink long names so they still fit on the sign
const signSize = Math.min(34, Math.floor(150 / Math.max(NAME.length, 3) / 0.62));
const pinSize = Math.min(19, Math.floor(58 / Math.max(NAME.length, 3) / 0.68));

const sign = {
  home: { top: 'VOTE FOR', bottom: 'SHE DID THE READING' },
  question: { top: 'VOTE FOR', bottom: 'ONE QUESTION AT A TIME' },
  quiz: { top: 'ELECT', bottom: 'FOR SUPREME COURT' },
  glossary: { top: 'VOTE FOR', bottom: 'KNOWS ALL THE WORDS' },
  settings: { top: 'VOTE FOR', bottom: 'PAID FOR BY HOMEWORK' },
}[page];
if (name === 'You') sign.bottom = sign.bottom.replace('SHE DID', 'YOU DID');
---

<div class="decor" aria-hidden="true" data-page={page}>
  <!-- left margin: a yard sign planted in the "lawn" -->
  <div class="piece yard">
    <svg viewBox="0 0 200 230" class="sign">
      <rect x="96" y="120" width="5" height="110" fill="#8c95a6" />
      <rect x="10" y="10" width="180" height="128" rx="6" fill="#fff" stroke="#1b2a5c" stroke-width="5" />
      <rect x="10" y="10" width="180" height="32" rx="6" fill="#1b2a5c" />
      <rect x="10" y="32" width="180" height="10" fill="#1b2a5c" />
      <text x="100" y="33" text-anchor="middle" class="t-small" fill="#fff">★ {sign.top} ★</text>
      <text x="100" y={84 + signSize / 3} text-anchor="middle" class="t-big" fill="#c8312b" style={`font-size:${signSize}px`}>{NAME}</text>
      <rect x="22" y="108" width="156" height="4" fill="#c8312b" />
      <text x="100" y="128" text-anchor="middle" class="t-tiny" fill="#1b2a5c">{sign.bottom}</text>
      <ellipse cx="98" cy="226" rx="44" ry="4" fill="#000" opacity=".08" />
    </svg>
  </div>

  <!-- right margin: a loose pile of stickers and a button -->
  <button type="button" class="piece sticker s1" tabindex="-1">
    <svg viewBox="0 0 150 100">
      <ellipse cx="75" cy="50" rx="71" ry="46" fill="#fff" stroke="#d9dde5" stroke-width="2" />
      <ellipse cx="75" cy="50" rx="64" ry="39" fill="#1b2a5c" />
      <clipPath id="ovl"><ellipse cx="75" cy="50" rx="64" ry="39" /></clipPath>
      <g clip-path="url(#ovl)">
        <rect x="75" y="11" width="70" height="9" fill="#c8312b" />
        <rect x="75" y="28" width="70" height="9" fill="#c8312b" />
        <rect x="75" y="63" width="70" height="9" fill="#c8312b" />
        <rect x="75" y="80" width="70" height="9" fill="#c8312b" />
        <rect x="75" y="20" width="70" height="8" fill="#fff" />
        <rect x="75" y="72" width="70" height="8" fill="#fff" />
      </g>
      <text x="45" y="35" text-anchor="middle" fill="#fff" class="t-stars">★ ★ ★</text>
      <text x="75" y="60" text-anchor="middle" class="t-voted" fill="#fff" stroke="#1b2a5c" stroke-width="5" paint-order="stroke">I VOTED!</text>
    </svg>
  </button>

  <button type="button" class="piece sticker s2" tabindex="-1">
    <svg viewBox="0 0 110 110">
      <circle cx="55" cy="55" r="52" fill="#fff" stroke="#d9dde5" stroke-width="2" />
      <circle cx="55" cy="55" r="46" fill="#c8312b" />
      <circle cx="55" cy="55" r="38" fill="#fff" />
      <circle cx="55" cy="55" r="34" fill="#1b2a5c" />
      <text x="55" y="42" text-anchor="middle" fill="#f2c94c" class="t-stars">★ ★ ★</text>
      <text x="55" y={60 + pinSize / 4} text-anchor="middle" fill="#fff" class="t-pin" style={`font-size:${pinSize}px`}>{NAME}</text>
      <text x="55" y="80" text-anchor="middle" fill="#fff" class="t-tiny">2026</text>
      <ellipse cx="40" cy="30" rx="16" ry="7" fill="#fff" opacity=".18" transform="rotate(-30 40 30)" />
    </svg>
  </button>

  <button type="button" class="piece sticker s3" tabindex="-1">
    <svg viewBox="0 0 130 78">
      <rect x="3" y="3" width="124" height="72" rx="14" fill="#f2c94c" stroke="#fff" stroke-width="4" />
      <text x="65" y="34" text-anchor="middle" class="t-studied" fill="#1b2a5c">I STUDIED</text>
      <text x="65" y="58" text-anchor="middle" class="t-small" fill="#1b2a5c">★ FOR THIS ★</text>
    </svg>
  </button>

  <div class="piece ballot">
    <svg viewBox="0 0 120 120">
      <rect x="36" y="8" width="48" height="44" rx="3" fill="#fff" stroke="#1b2a5c" stroke-width="3" transform="rotate(-8 60 30)" />
      <path d="M45 26l6 6 12-14" fill="none" stroke="#2f7a52" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" transform="rotate(-8 60 30)" />
      <rect x="14" y="48" width="92" height="66" rx="6" fill="#1b2a5c" />
      <rect x="14" y="48" width="92" height="14" rx="4" fill="#2c4a8a" />
      <rect x="34" y="52" width="52" height="5" rx="2" fill="#0d1530" />
      <text x="60" y="96" text-anchor="middle" class="t-small" fill="#fff">VOTE</text>
    </svg>
  </div>

  <!-- bunting: shown with the strip on narrow screens -->
  <div class="strip">
    <svg class="bunting" viewBox="0 0 600 34" preserveAspectRatio="none">
      <path d="M0 4 Q300 22 600 4" fill="none" stroke="#8c95a6" stroke-width="1.5" />
      {Array.from({ length: 12 }, (_, i) => {
        const x = 12 + i * 49;
        const y = 4 + 18 * Math.sin((Math.PI * (x + 12)) / 600) * 0.95;
        const fill = ['#c8312b', '#ffffff', '#2c4a8a'][i % 3];
        return <path d={`M${x} ${y} L${x + 24} ${y} L${x + 12} ${y + 22} Z`} fill={fill} stroke="#d9dde5" stroke-width="1" />;
      })}
    </svg>
  </div>
</div>

<style>
  .decor {
    --g: calc((100vw - 46rem) / 2); /* width of each margin */
    --w: clamp(110px, calc(var(--g) - 56px), 170px);
  }
  /* narrow screens (default): the whole cast lines up above the footer */
  .decor {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-end;
    gap: 4px 12px;
    max-width: 46rem;
    margin: 56px auto -56px;
    padding-inline: max(16px, env(safe-area-inset-left, 0px));
  }
  .piece {
    display: block;
    width: 78px;
    pointer-events: none;
  }
  .yard {
    width: 118px;
    margin-bottom: -6px;
  }
  .ballot {
    width: 58px;
  }
  .s1 {
    width: 92px;
    transform: rotate(-8deg);
  }
  .s2 {
    width: 64px;
    transform: rotate(9deg);
  }
  .s3 {
    width: 74px;
    transform: rotate(-4deg);
  }
  .sticker {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    filter: drop-shadow(0 3px 6px rgb(27 36 64 / 0.18));
    -webkit-tap-highlight-color: transparent;
  }
  .sticker.spin {
    animation: spin 0.7s cubic-bezier(0.3, 1.3, 0.5, 1);
  }
  .piece svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .strip {
    order: -1;
    flex-basis: 100%;
  }
  .bunting {
    display: block;
    width: 100%;
    height: 30px;
  }

  :global(.t-big) {
    font: 700 34px/1 'Public Sans', system-ui, sans-serif;
    letter-spacing: 0.02em;
  }
  :global(.t-small) {
    font: 700 13px/1 'Public Sans', system-ui, sans-serif;
    letter-spacing: 0.08em;
  }
  :global(.t-tiny) {
    font: 700 9.5px/1 'Public Sans', system-ui, sans-serif;
    letter-spacing: 0.08em;
  }
  :global(.t-stars) {
    font: 700 10px/1 system-ui, sans-serif;
    letter-spacing: 0.1em;
  }
  :global(.t-voted) {
    font: 700 italic 25px/1 'Source Serif 4', Georgia, serif;
  }
  :global(.t-pin) {
    font: 700 19px/1 'Public Sans', system-ui, sans-serif;
  }
  :global(.t-studied) {
    font: 700 19px/1 'Source Serif 4', Georgia, serif;
  }

  /* ── wide screens: decorations live in the margins ── */
  @media (min-width: 1100px) {
    .decor {
      display: block;
      margin: 0;
      padding: 0;
      max-width: none;
    }
    .piece {
      position: fixed;
      z-index: 1;
      width: var(--w);
    }
    .yard {
      left: calc((var(--g) - var(--w)) / 2);
      bottom: 0;
      transform-origin: 50% 100%;
      transform: rotate(-3deg);
      margin: 0;
    }
    .ballot {
      left: calc((var(--g) - var(--w) * 0.6) / 2);
      top: 120px;
      width: calc(var(--w) * 0.6);
      opacity: 0.9;
    }
    .sticker {
      right: calc((var(--g) - var(--w)) / 2);
      transition: transform 0.25s cubic-bezier(0.2, 1.4, 0.4, 1);
    }
    .s1 {
      width: var(--w);
      top: 110px;
      transform: rotate(-8deg);
    }
    .s2 {
      top: 250px;
      width: calc(var(--w) * 0.72);
      right: calc((var(--g) - var(--w) * 0.72) / 2 + 22px);
      transform: rotate(10deg);
    }
    .s3 {
      top: 380px;
      width: calc(var(--w) * 0.82);
      transform: rotate(-4deg);
    }
    .sticker:hover {
      transform: rotate(0deg) scale(1.06);
    }
    .strip {
      display: none;
    }
    /* short windows: keep the stickers from piling into the yard sign */
    @media (max-height: 720px) {
      .s3,
      .ballot {
        display: none;
      }
    }
  }
  @keyframes spin {
    from {
      transform: rotate(-360deg) scale(0.6);
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .piece {
      opacity: 0.88;
    }
  }
  :global(:root[data-theme='dark']) .piece {
    opacity: 0.88;
  }
  @media (prefers-reduced-motion: reduce) {
    .sticker {
      transition: none;
    }
    .sticker.spin {
      animation: none;
    }
  }
</style>

<script>
  import { confetti } from '../scripts/confetti';
  document.querySelectorAll<HTMLButtonElement>('.decor .sticker').forEach((s) =>
    s.addEventListener('click', () => {
      s.classList.remove('spin');
      void s.offsetWidth;
      s.classList.add('spin');
      const r = s.getBoundingClientRect();
      confetti(r.left + r.width / 2, r.top + r.height / 2, 28);
    }),
  );
</script>
