---
import Base from '../../layouts/Base.astro';
import { QUESTIONS, TOPICS } from '../../data/questions.js';

export function getStaticPaths() {
  return QUESTIONS.map((q) => ({ params: { id: String(q.id) }, props: { q } }));
}

const { q } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const idx = QUESTIONS.findIndex((x) => x.id === q.id);
const prev = QUESTIONS[idx - 1];
const next = QUESTIONS[idx + 1];
const topic = TOPICS[q.topic as keyof typeof TOPICS];
const total = QUESTIONS.length;
const pointCounts = JSON.stringify(QUESTIONS.map((x) => x.points.length));

// Research sites. %s is replaced with the search words.
const tools = [
  { name: 'Google', url: 'https://www.google.com/search?q=%s', note: 'Everything' },
  { name: 'Britannica', url: 'https://www.britannica.com/search?query=%s', note: 'Encyclopedia' },
  { name: 'Wikipedia', url: 'https://en.wikipedia.org/w/index.php?search=%s', note: 'Encyclopedia' },
  { name: 'Khan Academy', url: 'https://www.khanacademy.org/search?page_search_query=%s', note: 'AP Gov lessons' },
  { name: 'National Archives', url: 'https://www.archives.gov/search?query=%s', note: 'Founding documents' },
  { name: 'Library of Congress', url: 'https://www.loc.gov/search/?q=%s', note: 'History' },
  { name: 'Oyez', url: 'https://www.google.com/search?q=site%3Aoyez.org+%s', note: 'Supreme Court cases' },
  { name: 'Pew Research', url: 'https://www.pewresearch.org/search/%s', note: 'Polls & data' },
  { name: 'Census Bureau', url: 'https://www.census.gov/search-results.html?q=%s', note: 'Voting statistics' },
];

const steps = [
  { n: 1, title: 'Think it through', next: 'Look it up' },
  { n: 2, title: 'Look it up', next: 'Write your answer' },
  { n: 3, title: 'Write your answer', next: 'Check yourself' },
  { n: 4, title: 'Check yourself', next: 'Compare' },
  { n: 5, title: 'Compare with the backup answer', next: '' },
];

const answerHtml = q.answer
  .map((p: string) => (p.startsWith('<ul') ? p : p.startsWith('<table') ? `<div class="table-scroll">${p}</div>` : `<p>${p}</p>`))
  .join('');
---

<Base title={`Question ${q.id}`} current="question" description={q.q}>
  <main
    class="wrap qpage"
    data-id={q.id}
    data-question={q.q}
    data-total={total}
    data-points={q.points.length}
    data-all-points={pointCounts}
    style={`--unit: ${topic.color}`}
  >
    <nav class="qnav" aria-label="Question navigation">
      {prev ? <a class="btn small ghost" href={`${base}/q/${prev.id}/`} data-key="prev">← {prev.id}</a> : <span />}
      <span class="qcount mono">{q.id} / {total}</span>
      {next ? <a class="btn small ghost" href={`${base}/q/${next.id}/`} data-key="next">{next.id} →</a> : <a class="btn small ghost" href={`${base}/`}>Done ✓</a>}
    </nav>

    <header class="qhead">
      <div class="qmeta">
        <span class="unitchip">{topic.name}</span>
        <span class="save" id="save-state" role="status" aria-live="polite"></span>
      </div>
      <h1 class="qtext">{q.q}</h1>
      <ol class="starbar" aria-label="Stars for this question">
        <li data-star="0"><span class="star" aria-hidden="true">★</span> Write it</li>
        <li data-star="1"><span class="star" aria-hidden="true">★</span> Check it</li>
        <li data-star="2"><span class="star" aria-hidden="true">★</span> Nail it</li>
      </ol>
    </header>

    <div class="steps">
      {steps.map((s) => (
        <details class="step" data-step={s.n}>
          <summary>
            <span class="badge" aria-hidden="true"><span class="num">{s.n}</span><span class="tick">✓</span></span>
            <span class="stitle">{s.title}</span>
            <span class="sstatus" data-status-for={s.n}></span>
            <span class="chev" aria-hidden="true"></span>
          </summary>
          <div class="sbody">
            {s.n === 1 && (
              <>
                <p class="lead">Read the question twice. Is it asking you to define, list, compare, or explain?</p>
                <div class="hints">
                  <ol class="hintlist">
                    {q.hints.map((h: string, i: number) => (
                      <li class="hint" data-hint={i} hidden>
                        <span class="hint-label">Hint {i + 1}</span>
                        <span set:html={h} />
                      </li>
                    ))}
                  </ol>
                  <button type="button" class="btn" id="more-hint">💡 Show a hint <span class="hintcount" id="hint-count">(0 of {q.hints.length})</span></button>
                </div>
                <div class="terms">
                  <h3>Key terms to try to use</h3>
                  <p class="sub">Tap a term to see what it means. Using these words makes your answer stronger.</p>
                  <ul class="termlist">
                    {q.terms.map((t: { t: string; d: string }) => (
                      <li>
                        <details>
                          <summary>{t.t}</summary>
                          <p>{t.d}</p>
                        </details>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            )}

            {s.n === 2 && (
              <>
                <p class="lead">Type what you want to find, or tap a suggestion, then pick where to search. Results open in a new tab.</p>
                <label class="visually-hidden" for="search-box">Search words</label>
                <input type="search" id="search-box" value={q.search[0]} autocomplete="off" />
                <div class="suggest">
                  {q.search.map((x: string) => <button type="button" class="suggestion" data-s={x}>{x}</button>)}
                </div>
                <div class="tools">
                  {tools.map((t) => (
                    <a class="tool" data-url={t.url} href={t.url.replace('%s', encodeURIComponent(q.search[0]))} target="_blank" rel="noopener">
                      <strong>{t.name}</strong>
                      <span>{t.note}</span>
                    </a>
                  ))}
                </div>
                <p class="tip">Found a good fact? Paste it into your research notes in the next step, with where it came from.</p>
              </>
            )}

            {s.n === 3 && (
              <>
                <label for="answer">My answer</label>
                <textarea id="answer" rows="7" placeholder="Answer in your own words. Aim for a few complete sentences with an example."></textarea>
                <div class="meter" aria-hidden="true"><span id="meter-fill"></span></div>
                <div class="wordcount"><span id="wordcount">0 words</span><span id="wordgoal">20 words earns a star ★</span></div>
                <label for="notes">Research notes <span class="opt">(facts, quotes, links)</span></label>
                <textarea id="notes" rows="4" placeholder="Paste facts and where you found them, e.g. 'Census 2024: 65% voted (census.gov)'"></textarea>
              </>
            )}

            {s.n === 4 && (
              <>
                <p class="lead">A complete answer usually covers these. Tick the ones yours does. Most of them earns a star.</p>
                <ul class="checks">
                  {q.points.map((p: string, i: number) => (
                    <li>
                      <label><input type="checkbox" data-check={i} /> <span>{p}</span></label>
                    </li>
                  ))}
                </ul>
              </>
            )}

            {s.n === 5 && (
              <>
                <div id="gate">
                  <button type="button" class="btn primary" id="reveal">Show the backup answer</button>
                  <p class="nudge" id="nudge" hidden>
                    Try writing a sentence or two first. You'll remember it much better.
                    <button type="button" class="linklike" id="reveal-anyway">Show it anyway</button>
                  </p>
                </div>
                <article class="backup" id="backup" hidden>
                  <div class="backup-body" set:html={answerHtml} />
                  {q.sources.length > 0 && (
                    <div class="sources">
                      <h3>Sources</h3>
                      <ul>
                        {q.sources.map((src: { label: string; url: string }) => (
                          <li><a href={src.url} target="_blank" rel="noopener">{src.label}</a></li>
                        ))}
                      </ul>
                    </div>
                  )}
                  <div class="rate">
                    <h3>How did your answer compare?</h3>
                    <div class="ratebtns" role="group" aria-label="Rate your answer">
                      <button type="button" class="ratebtn" data-rate="got">🎯 Nailed it</button>
                      <button type="button" class="ratebtn" data-rate="partly">🟡 Mostly there</button>
                      <button type="button" class="ratebtn" data-rate="review">🔁 Review again</button>
                    </div>
                    <p class="cheer" id="cheer" role="status" aria-live="polite"></p>
                  </div>
                </article>
              </>
            )}

            {s.next && (
              <button type="button" class="nextstep" data-next={s.n + 1}>Next: {s.next} ↓</button>
            )}
          </div>
        </details>
      ))}
    </div>

    <nav class="qnav bottom" aria-label="Question navigation">
      {prev ? <a class="btn" href={`${base}/q/${prev.id}/`}>← Previous</a> : <span />}
      <a class="btn ghost" href={`${base}/`}>All questions</a>
      {next ? <a class="btn primary" href={`${base}/q/${next.id}/`}>Next question →</a> : <a class="btn primary" href={`${base}/`}>Finish</a>}
    </nav>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </main>
</Base>

<style>
  .qpage {
    padding-block: 20px 0;
  }
  .qnav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .qnav.bottom {
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .qcount {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .qhead {
    margin: 22px 0 22px;
  }
  .qmeta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .unitchip {
    font: 700 0.75rem/1 var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--unit);
    padding: 7px 11px;
    border-radius: 999px;
  }
  .save {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .save[data-kind='error'] {
    color: var(--bad);
  }
  .save[data-kind='synced'] {
    color: var(--ok);
  }
  .qtext {
    font: 700 clamp(1.5rem, 1.1rem + 1.8vw, 2.1rem) / 1.25 var(--font-display);
    margin: 14px 0 14px;
    letter-spacing: -0.01em;
  }
  .starbar {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .starbar li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    padding: 5px 11px 5px 8px;
    border: 1px dashed var(--line);
    border-radius: 999px;
  }
  .star {
    font-size: 1.05rem;
    line-height: 1;
    color: var(--line);
    transition: color 0.2s, transform 0.3s;
  }
  .starbar li.on {
    color: var(--ink);
    border-style: solid;
    border-color: var(--gold);
    background: var(--gold-soft);
  }
  .starbar li.on .star {
    color: var(--gold);
  }
  .starbar li.pop .star {
    animation: starpop 0.6s ease-out;
  }
  @keyframes starpop {
    0% {
      transform: scale(0.4) rotate(-40deg);
    }
    60% {
      transform: scale(1.6) rotate(10deg);
    }
  }

  /* ── step cards ── */
  .steps {
    display: grid;
    gap: 10px;
  }
  .step {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .step[open] {
    border-color: color-mix(in srgb, var(--unit) 55%, var(--line));
    box-shadow: var(--shadow);
  }
  .step > summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    cursor: pointer;
    border-radius: 14px;
  }
  .step > summary::-webkit-details-marker {
    display: none;
  }
  .step > summary:hover .stitle {
    color: var(--accent);
  }
  .badge {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--line);
    color: var(--ink-soft);
    font: 600 0.95rem/1 var(--font-mono);
    flex: none;
    transition: background 0.25s, border-color 0.25s, transform 0.25s;
  }
  .step[open] .badge {
    border-color: var(--unit);
    color: var(--unit);
  }
  .badge .tick {
    display: none;
  }
  .step.done .badge {
    background: var(--ok);
    border-color: var(--ok);
    color: #fff;
  }
  .step.done .badge .num {
    display: none;
  }
  .step.done .badge .tick {
    display: inline;
    font-family: var(--font-body);
    font-weight: 700;
  }
  .step.justdone .badge {
    animation: stamp 0.45s ease-out;
  }
  @keyframes stamp {
    0% {
      transform: scale(1.5);
    }
    70% {
      transform: scale(0.92);
    }
  }
  .stitle {
    font: 700 1.12rem/1.25 var(--font-display);
    min-width: 0;
    flex: 1;
  }
  .sstatus {
    font-size: 0.82rem;
    color: var(--muted);
    white-space: nowrap;
    text-align: right;
  }
  .step.done .sstatus {
    color: var(--ok);
  }
  .chev {
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    margin: -4px 4px 0 2px;
    transition: transform 0.2s;
    flex: none;
  }
  .step[open] .chev {
    transform: rotate(-135deg);
    margin-top: 4px;
  }
  .sbody {
    padding: 2px 18px 18px 60px;
    display: grid;
    gap: 14px;
  }
  .sbody > * {
    min-width: 0;
  }
  @media (max-width: 560px) {
    .sbody {
      padding: 2px 14px 16px;
    }
    .sstatus {
      display: none;
    }
  }
  .nextstep {
    justify-self: start;
    font: 600 0.9rem/1 var(--font-body);
    color: var(--accent);
    background: var(--accent-soft);
    border: 0;
    border-radius: 999px;
    padding: 9px 14px;
    cursor: pointer;
  }
  .nextstep:hover {
    filter: brightness(0.97);
  }

  .lead,
  .sub,
  .tip {
    margin: 0;
    color: var(--ink-soft);
  }
  .sub,
  .tip {
    font-size: 0.92rem;
  }
  .hints {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .hintlist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
    width: 100%;
  }
  .hint {
    background: var(--highlight);
    color: var(--highlight-ink);
    padding: 12px 14px;
    border-radius: 4px 12px 12px 12px;
    animation: pop 0.25s ease-out;
  }
  .hint-label {
    display: block;
    font: 600 0.72rem/1 var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
    opacity: 0.8;
  }
  @keyframes pop {
    from {
      transform: translateY(4px);
    }
  }
  .hintcount {
    font-weight: 400;
    color: var(--muted);
  }
  .terms h3,
  .sources h3,
  .rate h3 {
    font: 600 1rem/1.3 var(--font-body);
    margin: 6px 0 4px;
  }
  .termlist {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .termlist li {
    max-width: 100%;
  }
  .termlist details {
    border: 1px solid var(--line);
    background: var(--paper);
    border-radius: 8px;
    padding: 7px 12px;
  }
  .termlist details[open] {
    border-color: var(--unit);
  }
  .termlist summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .termlist details p {
    margin: 6px 0 2px;
    font-size: 0.93rem;
    color: var(--ink-soft);
    max-width: 40ch;
  }
  .suggest {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .suggestion {
    font: 400 0.85rem/1.2 var(--font-body);
    background: transparent;
    color: var(--accent);
    border: 1px dashed var(--accent);
    border-radius: 999px;
    padding: 5px 10px;
    cursor: pointer;
  }
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 8px;
  }
  .tool {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s, border-color 0.15s;
  }
  .tool:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .tool span {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .meter {
    height: 6px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    overflow: hidden;
    margin-top: -6px;
  }
  .meter span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--gold);
    transition: width 0.25s, background 0.25s;
  }
  .meter.full span {
    background: var(--ok);
  }
  .wordcount {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: -8px;
  }
  .opt {
    font-weight: 400;
    color: var(--muted);
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .checks label {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-weight: 400;
    cursor: pointer;
  }
  .checks input {
    width: 20px;
    height: 20px;
    margin-top: 3px;
    accent-color: var(--ok);
    flex: none;
  }
  .nudge {
    margin: 10px 0 0;
    padding: 12px 14px;
    background: var(--warn-soft);
    border-radius: 8px;
  }
  .linklike {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    cursor: pointer;
  }
  .backup {
    display: grid;
    gap: 16px;
  }
  .backup > * {
    min-width: 0;
  }
  .backup-body :global(p) {
    margin: 0 0 12px;
    max-width: 68ch;
  }
  .backup-body :global(ul) {
    margin: 0 0 12px;
    padding-left: 1.2em;
    display: grid;
    gap: 6px;
  }
  .sources ul {
    margin: 0;
    padding-left: 1.2em;
    font-size: 0.92rem;
  }
  .ratebtns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 6px 0;
  }
  .ratebtn {
    font: 600 0.92rem/1 var(--font-body);
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: transform 0.15s;
  }
  .ratebtn:hover {
    transform: translateY(-1px);
  }
  .ratebtn[aria-pressed='true'] {
    border-color: var(--ok);
    background: var(--ok-soft);
  }
  .cheer {
    margin: 4px 0 0;
    font-weight: 600;
    color: var(--ok);
    min-height: 1.5em;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    transform: translate(-50%, 140%);
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 10px 16px;
    border-radius: 999px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
    transition: transform 0.35s cubic-bezier(0.2, 1.4, 0.4, 1);
    z-index: 20;
    white-space: nowrap;
    max-width: calc(100vw - 32px);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .toast.show {
    transform: translate(-50%, 0);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<script>
  import { createNoteController, formatTime, getNote, type SyncState, type Rating } from '../../scripts/store';
  import { starsFor, rankFor } from '../../scripts/game';
  import { confetti } from '../../scripts/confetti';

  const page = document.querySelector<HTMLElement>('.qpage')!;
  const id = Number(page.dataset.id);
  const question = page.dataset.question ?? '';
  const total = Number(page.dataset.total);
  const pointCount = Number(page.dataset.points);
  const allPoints: number[] = JSON.parse(page.dataset.allPoints ?? '[]');

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const saveEl = $('#save-state');
  const answerEl = $<HTMLTextAreaElement>('#answer');
  const notesEl = $<HTMLTextAreaElement>('#notes');
  const hints = [...document.querySelectorAll<HTMLElement>('.hint')];
  const moreHint = $<HTMLButtonElement>('#more-hint');
  const hintCount = $('#hint-count');
  const checks = [...document.querySelectorAll<HTMLInputElement>('[data-check]')];
  const backup = $('#backup');
  const gate = $('#gate');
  const nudge = $('#nudge');
  const rateBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-rate]')];
  const steps = [...document.querySelectorAll<HTMLDetailsElement>('details.step')];
  const starEls = [...document.querySelectorAll<HTMLElement>('[data-star]')];
  const toastEl = $('#toast');

  function showSync(st: SyncState) {
    saveEl.dataset.kind = st.kind;
    if (st.kind === 'local') saveEl.textContent = 'Saved on this device';
    else if (st.kind === 'saving') saveEl.textContent = 'Saving to GitHub…';
    else if (st.kind === 'synced') saveEl.textContent = st.at ? `Saved to GitHub · ${formatTime(st.at)}` : 'Connected to GitHub';
    else saveEl.textContent = `⚠ ${st.message}`;
  }

  const ctl = createNoteController(id, question, showSync);

  let toastTimer: number | undefined;
  function toast(msg: string) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 2600);
  }

  const words = (s: string) => s.trim().split(/\s+/).filter(Boolean).length;

  function stepDone(n: number) {
    const note = ctl.get();
    switch (n) {
      case 1: return note.hintsShown > 0 || note.steps.includes(1);
      case 2: return note.researched || note.notes.trim().length > 0 || note.steps.includes(2);
      case 3: return words(note.answer) >= 20;
      case 4: return note.checks.length >= Math.ceil(pointCount * 0.6);
      case 5: return note.rating !== '';
    }
    return false;
  }

  function stepStatus(n: number) {
    const note = ctl.get();
    switch (n) {
      case 1: return note.hintsShown ? `${note.hintsShown} hint${note.hintsShown === 1 ? '' : 's'} used` : 'Hints & key terms';
      case 2: return stepDone(2) ? 'Researched' : 'Search tools';
      case 3: return `${words(note.answer)} words`;
      case 4: return `${note.checks.length} / ${pointCount} ticked`;
      case 5:
        if (note.rating === 'got') return 'Nailed it 🎯';
        if (note.rating === 'partly') return 'Mostly there';
        if (note.rating === 'review') return 'Review again';
        return words(note.answer) < 8 && !note.revealed ? '🔒 Write first' : 'Ready';
    }
    return '';
  }

  let lastDone = new Set<number>();
  let lastStars = -1;

  function render(first = false) {
    const n = ctl.get();
    if (document.activeElement !== answerEl) answerEl.value = n.answer;
    if (document.activeElement !== notesEl) notesEl.value = n.notes;
    hints.forEach((h, i) => (h.hidden = i >= n.hintsShown));
    hintCount.textContent = `(${n.hintsShown} of ${hints.length})`;
    moreHint.hidden = n.hintsShown >= hints.length;
    checks.forEach((c, i) => (c.checked = n.checks.includes(i)));
    backup.hidden = !n.revealed;
    gate.hidden = n.revealed;
    rateBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.rate === n.rating)));

    // word meter
    const w = words(answerEl.value);
    $('#wordcount').textContent = `${w} word${w === 1 ? '' : 's'}`;
    $('#wordgoal').textContent = w >= 20 ? 'Star earned ★' : `${20 - w} more for a star ★`;
    $('#meter-fill').style.width = `${Math.min(100, (w / 20) * 100)}%`;
    $('.meter').classList.toggle('full', w >= 20);

    // step cards
    const done = new Set<number>();
    steps.forEach((s) => {
      const k = Number(s.dataset.step);
      const isDone = stepDone(k);
      if (isDone) done.add(k);
      s.classList.toggle('done', isDone);
      if (!first && isDone && !lastDone.has(k)) {
        s.classList.remove('justdone');
        void s.offsetWidth;
        s.classList.add('justdone');
      }
      $(`[data-status-for="${k}"]`).textContent = stepStatus(k);
    });
    lastDone = done;

    // stars
    const st = starsFor(n, pointCount);
    const lit = [st.wrote, st.checked, st.nailed];
    starEls.forEach((el, i) => {
      const was = el.classList.contains('on');
      el.classList.toggle('on', lit[i]);
      if (!first && lit[i] && !was) {
        el.classList.remove('pop');
        void el.offsetWidth;
        el.classList.add('pop');
      }
    });
    if (!first && lastStars >= 0 && st.count > lastStars) {
      const totalStars = allStars();
      const r = rankFor(totalStars);
      const before = rankFor(totalStars - (st.count - lastStars));
      if (r.level > before.level) {
        toast(`${r.icon} Promoted to ${r.title}!`);
        confetti(window.innerWidth / 2, window.innerHeight * 0.4, 110);
      } else toast(`★ Star earned · ${totalStars} total`);
    }
    lastStars = st.count;
  }

  function allStars() {
    let t = 0;
    for (let i = 1; i <= total; i++) t += starsFor(i === id ? ctl.get() : getNote(i), allPoints[i - 1] ?? 0).count;
    return t;
  }

  // open the first unfinished step; finished ones start closed
  function openFirstUnfinished() {
    const firstOpen = steps.find((s) => !stepDone(Number(s.dataset.step))) ?? steps[steps.length - 1];
    steps.forEach((s) => (s.open = s === firstOpen));
  }

  answerEl.addEventListener('input', () => {
    ctl.update({ answer: answerEl.value });
    render();
  });
  notesEl.addEventListener('input', () => {
    ctl.update({ notes: notesEl.value });
    render();
  });

  moreHint.addEventListener('click', () => {
    ctl.update({ hintsShown: Math.min(hints.length, ctl.get().hintsShown + 1) });
    render();
  });

  checks.forEach((c) =>
    c.addEventListener('change', () => {
      const set = new Set(ctl.get().checks);
      const i = Number(c.dataset.check);
      c.checked ? set.add(i) : set.delete(i);
      ctl.update({ checks: [...set].sort((a, b) => a - b) });
      render();
    }),
  );

  // "Next" buttons close this card and open the next one
  document.querySelectorAll<HTMLButtonElement>('.nextstep').forEach((b) =>
    b.addEventListener('click', () => {
      const cur = Number(b.closest<HTMLElement>('details.step')!.dataset.step);
      const n = Number(b.dataset.next);
      if (!ctl.get().steps.includes(cur)) ctl.update({ steps: [...ctl.get().steps, cur] });
      steps.forEach((s) => (s.open = Number(s.dataset.step) === n));
      render();
      const target = steps[n - 1];
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (n === 3) window.setTimeout(() => answerEl.focus({ preventScroll: true }), 350);
    }),
  );

  function reveal() {
    ctl.update({ revealed: true });
    render();
  }
  $('#reveal').addEventListener('click', () => {
    if (words(ctl.get().answer) < 8) nudge.hidden = false;
    else reveal();
  });
  $('#reveal-anyway').addEventListener('click', reveal);

  rateBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const r = b.dataset.rate as Rating;
      const next = ctl.get().rating === r ? '' : r;
      ctl.update({ rating: next });
      const cheer = $('#cheer');
      if (next === 'got') {
        const rect = b.getBoundingClientRect();
        confetti(rect.left + rect.width / 2, rect.top, 80);
        const lines = ['Nice work!', 'You got it!', 'Boom. Nailed it.', 'That one is yours now.', 'Look at you go!'];
        cheer.textContent = `🎉 ${lines[Math.floor(Math.random() * lines.length)]}`;
      } else if (next === 'partly') cheer.textContent = 'Close! Add what was missing to your answer, then come back to it.';
      else if (next === 'review') cheer.textContent = 'Added to your review list. Coming back to it is how it sticks.';
      else cheer.textContent = '';
      render();
    }),
  );

  // research tools follow whatever is in the search box; using one counts as research
  const box = $<HTMLInputElement>('#search-box');
  const toolLinks = [...document.querySelectorAll<HTMLAnchorElement>('.tool')];
  const retarget = () => {
    const q = encodeURIComponent(box.value.trim());
    toolLinks.forEach((a) => (a.href = (a.dataset.url ?? '').replace('%s', q)));
  };
  box.addEventListener('input', retarget);
  toolLinks.forEach((a) =>
    a.addEventListener('click', () => {
      if (!ctl.get().researched) {
        ctl.update({ researched: true });
        render();
      }
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('.suggestion').forEach((b) =>
    b.addEventListener('click', () => {
      box.value = b.dataset.s ?? '';
      retarget();
      box.focus();
    }),
  );

  // arrow keys move between questions (not while typing)
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, [contenteditable]') || e.altKey || e.metaKey || e.ctrlKey) return;
    const dir = e.key === 'ArrowLeft' ? 'prev' : e.key === 'ArrowRight' ? 'next' : '';
    const link = dir && document.querySelector<HTMLAnchorElement>(`[data-key="${dir}"]`);
    if (link) link.click();
  });

  // try to finish saving before leaving the page
  window.addEventListener('pagehide', () => ctl.flush());
  document.addEventListener('visibilitychange', () => document.visibilityState === 'hidden' && ctl.flush());

  try {
    localStorage.setItem('civics:last', String(id));
  } catch {}

  render(true);
  openFirstUnfinished();
  ctl.pull().then((changed) => {
    if (changed) {
      render(true);
      openFirstUnfinished();
    }
  });
</script>
