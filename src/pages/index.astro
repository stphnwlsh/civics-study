---
import Base from '../layouts/Base.astro';
import { QUESTIONS, TOPICS } from '../data/questions.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const list = QUESTIONS.map((q) => ({ id: q.id, q: q.q, topic: q.topic }));
---

<Base title="Civics Study" current="home">
  <main class="wrap home" data-questions={JSON.stringify(list.map(({ id, q }) => ({ id, q })))}>
    <section class="intro">
      <p class="eyebrow">AP Civics · Voting, public opinion &amp; political culture</p>
      <h1>One question at a time.</h1>
      <p class="lede">
        Each question walks you through five steps: think it through with hints, look it up, write your own answer,
        check it, and then compare it with a researched backup answer. Your work saves as you type.
      </p>
      <div class="cta">
        <a class="btn primary" id="continue" href={`${base}/q/1/`}>Start with question 1 →</a>
        <button type="button" class="btn" id="copy-all">Copy all my answers</button>
        <span class="copied" id="copied" role="status" aria-live="polite"></span>
      </div>
    </section>

    <section class="progress" aria-label="Progress">
      <div class="bar" aria-hidden="true">
        <span class="seg mastered" id="bar-mastered"></span>
        <span class="seg answered" id="bar-answered"></span>
        <span class="seg started" id="bar-started"></span>
      </div>
      <dl class="stats">
        <div><dt><span class="dot" data-status="mastered"></span> Nailed</dt><dd class="mono" id="n-mastered">0</dd></div>
        <div><dt><span class="dot" data-status="answered"></span> Answered</dt><dd class="mono" id="n-answered">0</dd></div>
        <div><dt><span class="dot" data-status="started"></span> Started</dt><dd class="mono" id="n-started">0</dd></div>
        <div><dt><span class="dot" data-status="new"></span> Not started</dt><dd class="mono" id="n-new">{QUESTIONS.length}</dd></div>
      </dl>
      <p class="syncline" id="syncline" role="status" aria-live="polite"></p>
    </section>

    <section class="review" id="review" hidden>
      <h2>Review list</h2>
      <p class="sub">Questions you marked "Review again" or "Mostly there".</p>
      <ul class="reviewlist" id="reviewlist"></ul>
    </section>

    <section class="all">
      <div class="allhead">
        <h2>All {QUESTIONS.length} questions</h2>
        <div class="filters" role="group" aria-label="Filter by unit">
          <button type="button" class="filter" data-topic="" aria-pressed="true">All</button>
          {Object.entries(TOPICS).map(([key, t]) => (
            <button type="button" class="filter" data-topic={key} aria-pressed="false">{t.short}</button>
          ))}
        </div>
      </div>
      <ol class="qlist">
        {list.map((q) => (
          <li data-topic={q.topic} data-id={q.id}>
            <a href={`${base}/q/${q.id}/`}>
              <span class="num mono">{q.id}</span>
              <span class="qt">{q.q}</span>
              <span class="dot" data-status="new" aria-hidden="true"></span>
              <span class="visually-hidden status-text">Not started</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>

<style>
  .home {
    padding-block: 28px 0;
    display: grid;
    gap: 36px;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .intro h1 {
    font: 700 clamp(2rem, 1.4rem + 3vw, 3rem) / 1.1 var(--font-display);
    margin: 10px 0 12px;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-top: 20px;
  }
  .copied {
    font-size: 0.9rem;
    color: var(--ok);
  }
  .progress {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 20px;
    display: grid;
    gap: 14px;
  }
  .bar {
    display: flex;
    height: 12px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .seg {
    width: 0;
    transition: width 0.4s ease;
  }
  .seg.mastered {
    background: var(--ok);
  }
  .seg.answered {
    background: var(--accent);
  }
  .seg.started {
    background: var(--warn);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
  }
  .stats div {
    display: grid;
    gap: 2px;
  }
  .stats dt {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .stats dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 500;
  }
  .syncline {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  h2 {
    font: 700 1.35rem/1.2 var(--font-display);
    margin: 0;
  }
  .sub {
    margin: 4px 0 10px;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .reviewlist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .reviewlist a {
    color: var(--ink);
  }
  .allhead {
    display: grid;
    gap: 12px;
    margin-bottom: 12px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .filter {
    font: 600 0.85rem/1 var(--font-body);
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .filter[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .qlist {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .qlist a {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px 6px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .qlist a:hover {
    background: var(--card);
  }
  .num {
    color: var(--muted);
    font-size: 0.9rem;
    text-align: right;
  }
  .qt {
    min-width: 0;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<script>
  import { getNote, statusOf, syncAll, syncEnabled, formatTime, type Status } from '../scripts/store';

  const home = document.querySelector<HTMLElement>('.home')!;
  const questions: { id: number; q: string }[] = JSON.parse(home.dataset.questions ?? '[]');
  const base = document.querySelector<HTMLAnchorElement>('.brand')!.getAttribute('href')!.replace(/\/$/, '');
  const label: Record<Status, string> = { new: 'Not started', started: 'Started', answered: 'Answered', mastered: 'Nailed it' };

  function render() {
    const counts: Record<Status, number> = { new: 0, started: 0, answered: 0, mastered: 0 };
    const review: { id: number; q: string; rating: string }[] = [];
    let firstUnfinished: number | null = null;

    for (const { id, q } of questions) {
      const n = getNote(id);
      const st = statusOf(n);
      counts[st]++;
      if (firstUnfinished === null && st !== 'mastered' && st !== 'answered') firstUnfinished = id;
      if (n.rating === 'review' || n.rating === 'partly') review.push({ id, q, rating: n.rating });
      const li = document.querySelector(`.qlist li[data-id="${id}"]`);
      li?.querySelector('.dot')?.setAttribute('data-status', st);
      const txt = li?.querySelector('.status-text');
      if (txt) txt.textContent = label[st];
    }

    const total = questions.length;
    (Object.keys(counts) as Status[]).forEach((k) => {
      document.getElementById(`n-${k}`)!.textContent = String(counts[k]);
      const seg = document.getElementById(`bar-${k}`);
      if (seg) seg.style.width = `${(counts[k] / total) * 100}%`;
    });

    const cont = document.getElementById('continue') as HTMLAnchorElement;
    let last: number | null = null;
    try {
      last = Number(localStorage.getItem('civics:last')) || null;
    } catch {}
    const target = last ?? firstUnfinished ?? 1;
    if (counts.new !== total) {
      cont.href = `${base}/q/${target}/`;
      cont.textContent = `Continue with question ${target} →`;
    }

    const rv = document.getElementById('review')!;
    const ul = document.getElementById('reviewlist')!;
    rv.hidden = review.length === 0;
    ul.replaceChildren(
      ...review.map((r) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `${base}/q/${r.id}/`;
        a.textContent = `${r.rating === 'review' ? '🔁' : '🟡'} ${r.id}. ${r.q}`;
        li.append(a);
        return li;
      }),
    );
  }

  // unit filters
  const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
  filters.forEach((f) =>
    f.addEventListener('click', () => {
      filters.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
      const t = f.dataset.topic;
      document.querySelectorAll<HTMLElement>('.qlist li').forEach((li) => (li.hidden = Boolean(t) && li.dataset.topic !== t));
    }),
  );

  // copy every answer as plain text, ready to paste into a document
  document.getElementById('copy-all')!.addEventListener('click', async () => {
    const text = questions
      .map(({ id, q }) => {
        const a = getNote(id).answer.trim();
        return `${id}. ${q}\n${a || '(not answered yet)'}\n`;
      })
      .join('\n');
    const msg = document.getElementById('copied')!;
    try {
      await navigator.clipboard.writeText(text);
      msg.textContent = 'Copied. Paste it into your document.';
    } catch {
      msg.textContent = 'Your browser blocked copying. Try again, or copy from each question page.';
    }
  });

  render();

  const line = document.getElementById('syncline')!;
  if (syncEnabled()) {
    line.textContent = 'Checking GitHub for changes…';
    syncAll(questions, (m) => (line.textContent = m)).then((r) => {
      line.textContent = r.ok ? `${r.message} Last checked ${formatTime(new Date().toISOString())}.` : `⚠ ${r.message}`;
      render();
    });
  } else {
    line.innerHTML = `Saving on this device only. <a href="${base}/settings/">Set up GitHub saving</a> so your notes last.`;
  }
</script>
