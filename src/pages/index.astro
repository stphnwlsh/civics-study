---
import Base from '../layouts/Base.astro';
import { QUESTIONS, TOPICS } from '../data/questions.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const list = QUESTIONS.map((q) => ({ id: q.id, q: q.q, topic: q.topic, points: q.points.length }));
const maxStars = QUESTIONS.length * 3;
const units = Object.entries(TOPICS).map(([key, t]) => ({ key, ...t, count: QUESTIONS.filter((q) => q.topic === key).length }));
---

<Base title="Civics Study" current="home">
  <main class="wrap home" data-questions={JSON.stringify(list)} data-units={JSON.stringify(units.map((u) => u.key))}>
    <section class="intro">
      <p class="eyebrow">AP Civics · Voting, public opinion &amp; political culture</p>
      <h1>One question at a time.</h1>
      <p class="lede">
        Think it through, look it up, write your answer, check it, then compare. Every question can earn three stars,
        and stars climb you up the ladder from Registered Voter to Supreme Court Justice.
      </p>
      <div class="cta">
        <a class="btn primary" id="continue" href={`${base}/q/1/`}>Start with question 1 →</a>
        <button type="button" class="btn" id="copy-all">Copy all my answers</button>
        <span class="copied" id="copied" role="status" aria-live="polite"></span>
      </div>
    </section>

    <section class="player" aria-label="Your rank">
      <div class="rankicon" id="rank-icon" aria-hidden="true">🗳️</div>
      <div class="rankmain">
        <p class="ranklabel">Level <span id="rank-level">1</span></p>
        <p class="ranktitle" id="rank-title">Registered Voter</p>
        <div class="xp" aria-hidden="true"><span id="xp-fill"></span></div>
        <p class="ranknext" id="rank-next">8 stars to Poll Worker</p>
      </div>
      <dl class="pstats">
        <div><dt>Stars</dt><dd><span class="mono" id="stars-total">0</span><span class="of mono">/{maxStars}</span></dd></div>
        <div><dt>Streak</dt><dd><span class="mono" id="streak">0</span> <span class="of" id="streak-unit">days</span></dd></div>
        <div><dt>Answered</dt><dd><span class="mono" id="answered">0</span><span class="of mono">/{QUESTIONS.length}</span></dd></div>
      </dl>
      <p class="syncline" id="syncline" role="status" aria-live="polite"></p>
    </section>

    <section aria-labelledby="stickers-h">
      <h2 id="stickers-h">Unit stickers</h2>
      <p class="sub">Write an answer for every question in a unit to earn its sticker.</p>
      <ul class="stickers">
        {units.map((u) => (
          <li class="sticker" data-unit={u.key} style={`--c: ${u.color}`}>
            <div class="disc">
              <span class="smain">{u.sticker}</span>
              <span class="ssub mono" data-progress>0 / {u.count}</span>
            </div>
            <span class="sname">{u.short}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="review" id="review" hidden>
      <h2>Review list</h2>
      <p class="sub">Questions you marked "Review again" or "Mostly there".</p>
      <ul class="reviewlist" id="reviewlist"></ul>
    </section>

    <section class="all">
      <div class="allhead">
        <h2>All {QUESTIONS.length} questions</h2>
        <div class="filters" role="group" aria-label="Filter by unit">
          <button type="button" class="filter" data-topic="" aria-pressed="true">All</button>
          {units.map((u) => (
            <button type="button" class="filter" data-topic={u.key} aria-pressed="false" style={`--c: ${u.color}`}>{u.short}</button>
          ))}
        </div>
      </div>
      <ol class="qlist">
        {list.map((q) => (
          <li data-topic={q.topic} data-id={q.id} style={`--c: ${TOPICS[q.topic as keyof typeof TOPICS].color}`}>
            <a href={`${base}/q/${q.id}/`}>
              <span class="num mono">{q.id}</span>
              <span class="qt">{q.q}</span>
              <span class="qstars" aria-label="0 of 3 stars"><span>★</span><span>★</span><span>★</span></span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>

<style>
  .home {
    padding-block: 28px 0;
    display: grid;
    gap: 36px;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .intro h1 {
    font: 700 clamp(2rem, 1.4rem + 3vw, 3rem) / 1.1 var(--font-display);
    margin: 10px 0 12px;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-top: 20px;
  }
  .copied {
    font-size: 0.9rem;
    color: var(--ok);
  }

  /* ── player card ── */
  .player {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 6px 18px;
    align-items: center;
    box-shadow: var(--shadow);
  }
  .rankicon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 2rem;
    background: var(--gold-soft);
    border: 3px solid var(--gold);
  }
  .rankmain p {
    margin: 0;
  }
  .ranklabel {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ranktitle {
    font: 700 1.45rem/1.2 var(--font-display);
  }
  .xp {
    height: 10px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    overflow: hidden;
    margin: 8px 0 6px;
  }
  .xp span {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--gold), #f08c2e);
    transition: width 0.6s ease;
  }
  .ranknext {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .pstats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 18px;
    margin: 0;
  }
  .pstats dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pstats dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .of {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 400;
  }
  .syncline {
    grid-column: 1 / -1;
    margin: 10px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .player {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .pstats {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 8px;
    }
  }

  h2 {
    font: 700 1.35rem/1.2 var(--font-display);
    margin: 0;
  }
  .sub {
    margin: 4px 0 14px;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  /* ── unit stickers, in the spirit of an "I Voted" sticker ── */
  .stickers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
  }
  @media (max-width: 720px) {
    .stickers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .sticker {
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
  }
  .disc {
    width: 100%;
    max-width: 104px;
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-content: center;
    gap: 4px;
    padding: 10px;
    border: 2px dashed var(--line);
    color: var(--muted);
    background: var(--paper);
    transition: transform 0.3s;
  }
  .smain {
    font: 700 0.78rem/1.15 var(--font-display);
  }
  .ssub {
    font-size: 0.72rem;
  }
  .sname {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .sticker.earned .disc {
    border: 3px solid #fff;
    outline: 2px solid var(--c);
    background: radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--c) 70%, #fff), var(--c) 70%);
    color: #fff;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--c) 40%, transparent);
    transform: rotate(-6deg);
  }
  .sticker.earned:nth-child(even) .disc {
    transform: rotate(5deg);
  }
  .sticker.earned .smain {
    font-size: 0.82rem;
    text-shadow: 0 1px 0 rgb(0 0 0 / 0.2);
  }

  .reviewlist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .reviewlist a {
    color: var(--ink);
  }
  .allhead {
    display: grid;
    gap: 12px;
    margin-bottom: 12px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .filter {
    font: 600 0.85rem/1 var(--font-body);
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .filter[aria-pressed='true'] {
    background: var(--c, var(--ink));
    border-color: var(--c, var(--ink));
    color: #fff;
  }
  .filter[data-topic=''][aria-pressed='true'] {
    color: var(--paper);
  }
  .qlist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .qlist a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px 14px 12px 10px;
    border: 1px solid var(--line);
    border-left: 4px solid var(--c);
    border-radius: 10px;
    background: var(--card);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .qlist a:hover {
    transform: translateX(3px);
    box-shadow: var(--shadow);
  }
  .num {
    color: var(--muted);
    font-size: 0.9rem;
    text-align: right;
  }
  .qt {
    min-width: 0;
  }
  .qstars {
    display: flex;
    gap: 1px;
    font-size: 1rem;
    color: var(--line);
    letter-spacing: -1px;
  }
  .qstars .on {
    color: var(--gold);
  }
</style>

<script>
  import { getNote, syncAll, syncEnabled, formatTime, streak, dayOf } from '../scripts/store';
  import { starsFor, rankFor } from '../scripts/game';
  import { confetti } from '../scripts/confetti';

  const home = document.querySelector<HTMLElement>('.home')!;
  const questions: { id: number; q: string; topic: string; points: number }[] = JSON.parse(home.dataset.questions ?? '[]');
  const units: string[] = JSON.parse(home.dataset.units ?? '[]');
  const base = document.querySelector<HTMLAnchorElement>('.brand')!.getAttribute('href')!.replace(/\/$/, '');
  const $ = (id: string) => document.getElementById(id)!;

  function earnedBefore(): Set<string> {
    try {
      return new Set(JSON.parse(localStorage.getItem('civics:stickers') ?? '[]'));
    } catch {
      return new Set();
    }
  }

  function render(celebrate = false) {
    let stars = 0;
    let answered = 0;
    let firstUnfinished: number | null = null;
    const review: { id: number; q: string; rating: string }[] = [];
    const unitDone: Record<string, number> = {};
    const unitTotal: Record<string, number> = {};
    const days: string[] = [];

    for (const q of questions) {
      const n = getNote(q.id);
      const s = starsFor(n, q.points);
      stars += s.count;
      if (s.wrote) answered++;
      if (n.updated) days.push(dayOf(n.updated));
      unitTotal[q.topic] = (unitTotal[q.topic] ?? 0) + 1;
      if (s.wrote) unitDone[q.topic] = (unitDone[q.topic] ?? 0) + 1;
      if (firstUnfinished === null && !s.wrote) firstUnfinished = q.id;
      if (n.rating === 'review' || n.rating === 'partly') review.push({ id: q.id, q: q.q, rating: n.rating });

      const el = document.querySelector(`.qlist li[data-id="${q.id}"] .qstars`);
      if (el) {
        [...el.children].forEach((c, i) => c.classList.toggle('on', i < s.count));
        el.setAttribute('aria-label', `${s.count} of 3 stars`);
      }
    }

    // rank
    const r = rankFor(stars);
    $('rank-icon').textContent = r.icon;
    $('rank-level').textContent = String(r.level);
    $('rank-title').textContent = r.title;
    $('xp-fill').style.width = r.next ? `${((stars - r.from) / (r.next.at - r.from)) * 100}%` : '100%';
    $('rank-next').textContent = r.next
      ? `${r.toNext} more star${r.toNext === 1 ? '' : 's'} to ${r.next.title} ${r.next.icon}`
      : 'Top rank. The whole Court would be proud. ⚖️';
    $('stars-total').textContent = String(stars);
    $('answered').textContent = String(answered);
    const st = streak(days);
    $('streak').textContent = st ? `🔥 ${st}` : '0';
    $('streak-unit').textContent = st === 1 ? 'day' : 'days';

    // stickers
    const before = earnedBefore();
    const now = new Set<string>();
    for (const u of units) {
      const li = document.querySelector<HTMLElement>(`.sticker[data-unit="${u}"]`)!;
      const done = unitDone[u] ?? 0;
      const all = unitTotal[u] ?? 0;
      li.querySelector('[data-progress]')!.textContent = done >= all ? 'Earned!' : `${done} / ${all}`;
      li.classList.toggle('earned', done >= all && all > 0);
      if (done >= all && all > 0) now.add(u);
    }
    const fresh = [...now].filter((u) => !before.has(u));
    if (celebrate && fresh.length) {
      const el = document.querySelector<HTMLElement>(`.sticker[data-unit="${fresh[0]}"] .disc`)!;
      const rect = el.getBoundingClientRect();
      confetti(rect.left + rect.width / 2, rect.top + rect.height / 2, 120);
    }
    try {
      localStorage.setItem('civics:stickers', JSON.stringify([...now]));
    } catch {}

    // continue button
    const cont = $('continue') as HTMLAnchorElement;
    let last: number | null = null;
    try {
      last = Number(localStorage.getItem('civics:last')) || null;
    } catch {}
    const target = last ?? firstUnfinished ?? 1;
    if (stars > 0 || last) {
      cont.href = `${base}/q/${target}/`;
      cont.textContent = `Continue with question ${target} →`;
    }

    // review list
    $('review').hidden = review.length === 0;
    $('reviewlist').replaceChildren(
      ...review.map((rv) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `${base}/q/${rv.id}/`;
        a.textContent = `${rv.rating === 'review' ? '🔁' : '🟡'} ${rv.id}. ${rv.q}`;
        li.append(a);
        return li;
      }),
    );
  }

  // unit filters
  const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
  filters.forEach((f) =>
    f.addEventListener('click', () => {
      filters.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
      const t = f.dataset.topic;
      document.querySelectorAll<HTMLElement>('.qlist li').forEach((li) => (li.hidden = Boolean(t) && li.dataset.topic !== t));
    }),
  );

  // copy every answer as plain text, ready to paste into a document
  $('copy-all').addEventListener('click', async () => {
    const text = questions
      .map(({ id, q }) => {
        const a = getNote(id).answer.trim();
        return `${id}. ${q}\n${a || '(not answered yet)'}\n`;
      })
      .join('\n');
    const msg = $('copied');
    try {
      await navigator.clipboard.writeText(text);
      msg.textContent = 'Copied. Paste it into your document.';
    } catch {
      msg.textContent = 'Your browser blocked copying. Try again, or copy from each question page.';
    }
  });

  render(true);

  const line = $('syncline');
  if (syncEnabled()) {
    line.textContent = 'Checking GitHub for changes…';
    syncAll(questions, (m) => (line.textContent = m)).then((r) => {
      line.textContent = r.ok ? `${r.message} Last checked ${formatTime(new Date().toISOString())}.` : `⚠ ${r.message}`;
      render(true);
    });
  } else {
    line.innerHTML = `Saving on this device only. <a href="${base}/settings/">Set up GitHub saving</a> so your notes last.`;
  }
</script>
