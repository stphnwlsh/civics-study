---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'glossary' | 'quiz' | 'settings' | 'question';
}

const { title, description = 'Study one civics question at a time: hints, research tools, your own notes, and a backup answer.', current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = title === 'Civics Study' ? title : `${title} · Civics Study`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Public+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
    />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href={`${base}/`} aria-label="Civics Study home">
          <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="9" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M8 9V5.5A1.5 1.5 0 0 1 9.5 4h5A1.5 1.5 0 0 1 16 5.5V9" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M9 13.5l2 2 4-4" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="brand-text">Civics Study</span>
        </a>
        <nav class="topnav" aria-label="Main">
          <a href={`${base}/`} aria-current={current === 'home' ? 'page' : undefined}>Questions</a>
          <a href={`${base}/quiz/`} aria-current={current === 'quiz' ? 'page' : undefined}>Quiz</a>
          <a href={`${base}/glossary/`} aria-current={current === 'glossary' ? 'page' : undefined}>Key terms</a>
          <a href={`${base}/settings/`} aria-current={current === 'settings' ? 'page' : undefined}>Settings</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="wrap">
        Backup answers are researched starting points, not the only right answer. Your teacher and textbook come first.
        Figures checked November 2026.
      </div>
    </footer>
  </body>
</html>
